# ai-dev-harness Claude MR 리뷰 예시 유닛(init이 설치하지 않는다). 설치 절차는 키트 docs/install.md 14절.
# claude-review(설정 이름·계정·경로)를 서버 값으로 바꿔 /etc/systemd/system/claude-review-runner.service에 root 소유 0644로 둔다.
[Unit]
Description=Claude 리뷰 Runner (보호된 CI 전용)
Wants=network-online.target
Requires=claude-review-guard.service
After=network-online.target claude-review-guard.service
ConditionPathExists=/home/claude-review/gitlab-runner/config.toml
# 네트워크 경계와 신뢰된 CI를 검증할 때까지 비활성 상태로 유지한다.
ConditionPathExists=/etc/claude-review/enable-runner

[Service]
Type=simple
User=claude-review
Group=claude-review
WorkingDirectory=/home/claude-review/gitlab-runner
Environment=HOME=/home/claude-review
Environment=PATH=/home/claude-review/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISABLE_AUTOUPDATER=1
UMask=0077
# root 소유의 고정 검증기만 권한을 높여 실행하며 Runner 계정에는 sudo 권한을 주지 않는다.
ExecStartPre=+/usr/bin/python3 -I -B /usr/local/lib/claude-review/network-guard.py --config /etc/claude-review/config.json verify
ExecStart=/usr/bin/gitlab-runner run --config /home/claude-review/gitlab-runner/config.toml --working-directory /home/claude-review/gitlab-runner
Restart=on-failure
RestartSec=10
KillSignal=SIGQUIT
TimeoutStopSec=90
KillMode=control-group
CPUQuota=100%
MemoryHigh=2G
MemoryMax=3G
MemorySwapMax=0
TasksMax=128
LimitNOFILE=4096
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/claude-review
ReadWritePaths=/home/claude-review
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# 같은 서버의 다른 Runner 설정 디렉터리가 있으면 아래 목록에 -/etc/<그 Runner> 형태로 덧붙인다.
InaccessiblePaths=-/run/docker.sock -/run/containerd -/run/dbus -/run/systemd/private -/run/user -/var/lib/docker -/var/lib/containerd -/etc/gitlab-runner -/srv

[Install]
WantedBy=multi-user.target
